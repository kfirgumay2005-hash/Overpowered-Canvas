		"obsidian": "^1.14.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"elkjs": "^0.12.0",
		"monkey-around": "^3.0.0",
		"perfect-freehand": "^1.2.3"
	}
}
