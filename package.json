{
	"name": "overpowered-canvas",
	"version": "0.3.0",
	"private": true,
	"description": "Turns Obsidian Canvas into a Miro-level whiteboard.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
